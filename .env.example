# copy เป็น .env แล้วแก้ค่า — production บน Droplet 1 (pm2 · deploy/README.md) กรอก NUXT_SESSION_PASSWORD · NUXT_API_BASE · BO_PORT

# Public URL, used for OG Image when running nuxt generate (production: https://<DOMAIN> ถ้ามี)
NUXT_PUBLIC_SITE_URL=

# --- Auth & API integration (README.md → "Auth & API integration") ---
# apollo-api base URL. Server-side only: the browser calls /backend/** and Nitro proxies it here.
#   dev = http://localhost:3001 · production (pm2 · api บนเครื่องเดียวกัน) = http://127.0.0.1:20001 · docker compose override เป็น http://gttm-api:3001 เอง
NUXT_API_BASE=http://localhost:3001
# Secret that seals the httpOnly session cookie holding the API token. REQUIRED, >= 32 chars; the server refuses
# to start otherwise. Changing it invalidates every session. Generate: openssl rand -base64 48 | tr -d '/+=' | head -c 40
NUXT_SESSION_PASSWORD=
# Cookie name (optional)
NUXT_SESSION_NAME=apollo-bo-session

# Local BO login for browser checks. Not read by the app. Real values go in .env only.
BO_USERNAME=
BO_PASSWORD=

# --- production (pm2: deploy/ecosystem.config.cjs อ่านไฟล์นี้ · docker compose: docker-compose.yml อ่านไฟล์นี้) ---
# พอร์ตที่ bo ฟัง · BO_BIND=0.0.0.0 = เปิดสู่ภายนอก · ใช้ Caddy (TLS) แล้วให้ตั้ง 127.0.0.1
BO_PORT=20000
BO_BIND=0.0.0.0
# (optional) โดเมน + TLS: pm2 → ลง caddy ด้วย apt + deploy/Caddyfile.pm2 · docker → docker compose --profile tls up -d --build --wait
DOMAIN=
ACME_EMAIL=
# tag ของ image ที่ docker compose build/รัน (โหมด docker เท่านั้น)
TAG=latest
